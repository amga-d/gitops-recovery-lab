#cloud-config

hostname: ${SERVER_VM}
users:
  - name: ${SERVER_SSH_USER}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${SSH_PUBKEY}
package_update: true
packages:
  - qemu-guest-agent
  - curl
  - git

runcmd:
  - systemctl enable --now qemu-guest-agent
  - curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION=${K3S_VERSION} K3S_TOKEN=${K3S_TOKEN} sh -s - server --cluster-init --flannel-backend=none --disable-network-policy --write-kubeconfig-mode 644 --cluster-cidr=${CLUSTER_CIDR}
  - until /usr/local/bin/kubectl get nodes; do sleep 5; done
  - curl -sfL -o /tmp/calico.yaml https://raw.githubusercontent.com/projectcalico/calico/${CALICO_VERSION}/manifests/calico.yaml
  - |
    sed -i -e 's|# - name: CALICO_IPV4POOL_CIDR|- name: CALICO_IPV4POOL_CIDR|' -e 's|#   value: "192.168.0.0/16"|  value: "${CLUSTER_CIDR}"|' /tmp/calico.yaml
  - /usr/local/bin/kubectl apply -f /tmp/calico.yaml
