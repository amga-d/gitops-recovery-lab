#cloud-config

hostname: ${SERVER_VM}
users:
  - name: ${SERVER_SSH_USER}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${SSH_PUBKEY}
package_update: true
packages:
  - qemu-guest-agent
  - curl
  - git
  - chrony

# Written before k3s starts, so the bundled Traefik is pinned to the tainted
# server from its first install: every app's traffic then enters at one place.
write_files:
  - path: /var/lib/rancher/k3s/server/manifests/traefik-config.yaml
    content: |
      apiVersion: helm.cattle.io/v1
      kind: HelmChartConfig
      metadata:
        name: traefik
        namespace: kube-system
      spec:
        valuesContent: |-
          nodeSelector:
            node-role.kubernetes.io/control-plane: "true"
          tolerations:
            - key: CriticalAddonsOnly
              operator: Exists

# Downloads go over the host's uplink, which drops now and then: retry each
# one, and stop with an error instead of waiting forever for a missing k3s.
runcmd:
  - systemctl enable --now qemu-guest-agent
  - |
    for i in 1 2 3 4 5; do
      curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION=${K3S_VERSION} K3S_TOKEN=${K3S_TOKEN} sh -s - server --cluster-init --flannel-backend=none --disable-network-policy --write-kubeconfig-mode 644 --cluster-cidr=${CLUSTER_CIDR} --node-taint ${SERVER_NODE_TAINT} && break
      echo "k3s install attempt $i failed; retrying in 20s"; sleep 20
    done
  - test -x /usr/local/bin/kubectl || exit 1
  - until /usr/local/bin/kubectl get nodes; do sleep 5; done
  - curl -sfL --retry 5 --retry-all-errors --retry-delay 10 -o /tmp/calico.yaml https://raw.githubusercontent.com/projectcalico/calico/${CALICO_VERSION}/manifests/calico.yaml
  - |
    sed -i -e 's|# - name: CALICO_IPV4POOL_CIDR|- name: CALICO_IPV4POOL_CIDR|' -e 's|#   value: "192.168.0.0/16"|  value: "${CLUSTER_CIDR}"|' /tmp/calico.yaml
  - /usr/local/bin/kubectl apply -f /tmp/calico.yaml
