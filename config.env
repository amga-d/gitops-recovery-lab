# Committed lab defaults. Secrets live in .env (git-ignored, auto-generated).
# Every version here is pinned so a fresh `make up` rebuilds the same lab.

# --- VMs -------------------------------------------------------------------
SERVER_VM=k3s-server
AGENT_VM=k3s-agent
VM_MEMORY_MB=2048
VM_VCPUS=2
VM_DISK_SIZE=10G
VM_NETWORK=default
VM_OS_VARIANT=ubuntu24.04
BASE_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
BASE_IMAGE=.state/images/noble-base.img

# --- Access ----------------------------------------------------------------
SSH_KEY=~/.ssh/k3s_id_ed25519
SSH_PUBKEY_FILE=~/.ssh/k3s_id_ed25519.pub
SERVER_SSH_USER=server
AGENT_SSH_USER=agent

# --- Kubernetes ------------------------------------------------------------
K3S_VERSION=v1.36.5+k3s1
CALICO_VERSION=v3.33.0
CLUSTER_CIDR=172.20.0.0/16
KUBE_CONTEXT=k3s
KUBECONFIG_FILE=~/.kube/config

# --- Platform --------------------------------------------------------------
GITEA_CHART_VERSION=12.7.0
GITEA_ADMIN_USER=researcher
GITEA_NODEPORT=30300
ARGOCD_CHART_VERSION=10.10.5
ARGOCD_NODEPORT=30080
