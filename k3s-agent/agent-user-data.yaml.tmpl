#cloud-config

hostname: k3s-agent
users:
  - name: agent
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
    - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAID9Uq41XnnXjOaq3uPH3J7RRAb2LjLE64UIG4JaVf2z5 k3s-server-agent
package_update: true
packages:
  - qemu-guest-agent
  - curl
  - git


runcmd:
  - systemctl enable --now qemu-guest-agent
  - curl -sfL https://get.k3s.io | K3S_URL=https://${SERVER_IP}:6443 K3S_TOKEN=${K3S_TOKEN} sh -
