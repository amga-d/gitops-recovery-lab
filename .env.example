# Copy to .env to set your own values; otherwise scripts generate .env on first run.
# K3S_TOKEN must match the token of an already-provisioned cluster if you reuse VMs.
K3S_TOKEN=change-me
GITEA_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: where trial results are written (default .state/results inside the repo).
# RESULTS_DIR=~/path/outside/the/repo/results
